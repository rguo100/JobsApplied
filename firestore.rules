rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validAtsProvider(value) {
      return value == 'greenhouse';
    }

    function validAttemptStatus(value) {
      return value in ['pending', 'confirmed', 'failed', 'uncertain'];
    }

    function validVerification(data) {
      return data.verification is map
        && data.verification.keys().hasOnly(['method', 'evidenceCode', 'verifiedAt'])
        && data.verification.method in ['success_dom', 'success_url', 'manual']
        && (data.verification.evidenceCode == null || data.verification.evidenceCode is string)
        && data.verification.verifiedAt is timestamp;
    }

    function validAttemptOutcome(data) {
      return validAttemptStatus(data.status)
        && (
          (data.status == 'confirmed'
            && validVerification(data)
            && data.userConfirmedAt is timestamp
            && (data.submitClickedAt == null || data.submitClickedAt is timestamp)
            && data.failureCode == null)
          || (data.status != 'confirmed'
            && data.verification == null
            && (data.userConfirmedAt == null || data.userConfirmedAt is timestamp)
            && (data.submitClickedAt == null || data.submitClickedAt is timestamp)
            && (data.failureCode == null || data.failureCode is string))
        );
    }

    function validCanonicalAtsId(value) {
      return value is string
        && value.matches('^greenhouse:[a-z0-9][a-z0-9_-]*:[0-9]+$');
    }

    function validUserConfirmationTransition() {
      return request.resource.data.userConfirmedAt == resource.data.userConfirmedAt
        || (resource.data.userConfirmedAt == null
          && request.resource.data.userConfirmedAt is timestamp);
    }

    function validOptionalProfileFields(data) {
      return (!('phone' in data) || data.phone is string)
        && (!('city' in data) || data.city is string)
        && (!('region' in data) || data.region is string)
        && (!('country' in data) || data.country is string)
        && (!('linkedinUrl' in data) || data.linkedinUrl is string)
        && (!('githubUrl' in data) || data.githubUrl is string)
        && (!('portfolioUrl' in data) || data.portfolioUrl is string);
    }

    function validBoundedStringList(values) {
      return values is list && values.size() <= 10;
    }

    function validChoices(options) {
      return options is list && options.size() <= 10;
    }

    function validChoiceMetadata(answer) {
      return !('choiceMetadata' in answer)
        || (answer.choiceMetadata is map
          && answer.choiceMetadata.keys().hasOnly(['options'])
          && answer.choiceMetadata.keys().hasAll(['options'])
          && validChoices(answer.choiceMetadata.options));
    }

    function validAnswerValue(answer) {
      return ((answer.fieldType in ['text', 'textarea', 'email', 'tel', 'select', 'radio', 'other'])
          && answer.value is string && answer.value.size() <= 4000)
        || (answer.fieldType == 'checkbox'
          && (answer.value is bool || validBoundedStringList(answer.value)))
        || (answer.fieldType == 'multiselect' && validBoundedStringList(answer.value));
    }

    function validSavedAnswer(answer) {
      return answer is map
        && answer.keys().hasOnly(['fieldKey', 'question', 'fieldType', 'value', 'choiceMetadata'])
        && answer.keys().hasAll(['fieldKey', 'question', 'fieldType', 'value'])
        && answer.fieldKey is string && answer.fieldKey.size() > 0 && answer.fieldKey.size() <= 128
        && answer.fieldKey.matches('^[a-z0-9]+(_[a-z0-9]+)*$')
        && !answer.fieldKey.matches('.*(password|passcode|secret|government|social_security|ssn|sin|date_of_birth|dob|demographic|ethnicity|race|gender|disability|veteran|medical|health|eeo|work_authorization|sponsor|salary|compensation).*')
        && answer.question is string && answer.question.size() > 0 && answer.question.size() <= 500
        && answer.fieldType in ['text', 'textarea', 'email', 'tel', 'select', 'radio', 'checkbox', 'multiselect', 'other']
        && validAnswerValue(answer)
        && validChoiceMetadata(answer);
    }

    function validSavedAnswers(answers) {
      return answers is list && answers.size() <= 10
        && (answers.size() <= 0 || validSavedAnswer(answers[0]))
        && (answers.size() <= 1 || validSavedAnswer(answers[1]))
        && (answers.size() <= 2 || validSavedAnswer(answers[2]))
        && (answers.size() <= 3 || validSavedAnswer(answers[3]))
        && (answers.size() <= 4 || validSavedAnswer(answers[4]))
        && (answers.size() <= 5 || validSavedAnswer(answers[5]))
        && (answers.size() <= 6 || validSavedAnswer(answers[6]))
        && (answers.size() <= 7 || validSavedAnswer(answers[7]))
        && (answers.size() <= 8 || validSavedAnswer(answers[8]))
        && (answers.size() <= 9 || validSavedAnswer(answers[9]));
    }

    function validResumeReference(resume) {
      return resume == null
        || (resume is map
          && resume.keys().hasOnly(['fileName', 'fileSize', 'mimeType', 'storageStatus', 'storagePath'])
          && resume.keys().hasAll(['fileName', 'storageStatus', 'storagePath'])
          && resume.fileName is string && resume.fileName.size() > 0 && resume.fileName.size() <= 255
          && (!('fileSize' in resume) || (resume.fileSize is int && resume.fileSize >= 0 && resume.fileSize <= 52428800))
          && (!('mimeType' in resume) || (resume.mimeType is string && resume.mimeType.size() > 0 && resume.mimeType.size() <= 128))
          && resume.storageStatus == 'reference_only'
          && resume.storagePath == null);
    }

    function validApplicationMemory(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'atsJobId', 'provider', 'canonicalUrl', 'status',
          'answers', 'resume', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'atsJobId', 'provider', 'canonicalUrl', 'status',
          'answers', 'resume', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && validCanonicalAtsId(data.atsJobId)
        && data.provider == 'greenhouse'
        && data.canonicalUrl is string && data.canonicalUrl.size() > 0 && data.canonicalUrl.size() <= 2048
        && data.status == 'draft'
        && validSavedAnswers(data.answers)
        && validResumeReference(data.resume)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validV2ApplicationMemory(data, atsJobDocumentId) {
      return data.keys().hasOnly([
          'schemaVersion', 'atsJobId', 'atsJobDocumentId', 'provider', 'canonicalUrl',
          'boardToken', 'jobId', 'status', 'resume', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'atsJobId', 'atsJobDocumentId', 'provider', 'canonicalUrl',
          'boardToken', 'jobId', 'status', 'resume', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 2
        && validCanonicalAtsId(data.atsJobId)
        && data.atsJobDocumentId == atsJobDocumentId
        && atsJobDocumentId.matches('^greenhouse%3A[a-z0-9][a-z0-9_-]*%3A[0-9]+$')
        && data.provider == 'greenhouse'
        && data.boardToken is string && data.boardToken.matches('^[a-z0-9][a-z0-9_-]*$')
        && data.jobId is string && data.jobId.matches('^[0-9]+$')
        && data.atsJobId == 'greenhouse:' + data.boardToken + ':' + data.jobId
        && data.atsJobDocumentId == 'greenhouse%3A' + data.boardToken + '%3A' + data.jobId
        && data.canonicalUrl == 'https://job-boards.greenhouse.io/' + data.boardToken + '/jobs/' + data.jobId
        && data.status == 'draft'
        && validResumeReference(data.resume)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validV2AnswerContent(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'atsJobId', 'fieldKey', 'question', 'fieldType', 'value',
          'choiceMetadata', 'revision', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'atsJobId', 'fieldKey', 'question', 'fieldType', 'value',
          'revision', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && validCanonicalAtsId(data.atsJobId)
        && data.fieldKey is string && data.fieldKey.size() > 0 && data.fieldKey.size() <= 128
        && data.fieldKey.matches('^[a-z0-9]+(_[a-z0-9]+)*$')
        && !data.fieldKey.matches('.*(password|passcode|secret|government|social_security|ssn|sin|date_of_birth|dob|demographic|ethnicity|race|gender|disability|veteran|medical|health|eeo|work_authorization|sponsor|salary|compensation).*')
        && data.question is string && data.question.size() > 0 && data.question.size() <= 500
        && data.fieldType in ['text', 'textarea', 'email', 'tel', 'select', 'radio', 'checkbox', 'multiselect', 'other']
        && validAnswerValue(data)
        && validChoiceMetadata(data)
        && data.revision is int && data.revision >= 1 && data.revision <= 2147483647
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function activeV2Memory(userId, atsJobDocumentId) {
      return exists(/databases/$(database)/documents/users/$(userId)/applicationMemories/$(atsJobDocumentId))
        && get(/databases/$(database)/documents/users/$(userId)/applicationMemories/$(atsJobDocumentId)).data.schemaVersion == 2
        && get(/databases/$(database)/documents/users/$(userId)/applicationMemories/$(atsJobDocumentId)).data.atsJobDocumentId == atsJobDocumentId
        && get(/databases/$(database)/documents/users/$(userId)/applicationMemories/$(atsJobDocumentId)).data.status == 'draft';
    }

    function answerMatchesParent(userId, atsJobDocumentId, data) {
      return data.atsJobId == get(/databases/$(database)/documents/users/$(userId)/applicationMemories/$(atsJobDocumentId)).data.atsJobId;
    }

    function validAttemptTransition() {
      return resource.data.status == request.resource.data.status
        || resource.data.status == 'pending'
        || (resource.data.status in ['failed', 'uncertain']
          && request.resource.data.status == 'confirmed')
        || (resource.data.status == 'uncertain'
          && request.resource.data.status == 'failed');
    }

    // Applications subcollection: users/{userId}/applications/{applicationId}
    match /users/{userId}/applications/{applicationId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/atsJobs/{atsJobDocumentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'atsJobId', 'provider', 'boardToken', 'jobId', 'canonicalUrl',
          'company', 'title', 'linkedInPostingIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'atsJobId', 'provider', 'boardToken', 'jobId', 'canonicalUrl',
          'company', 'title', 'linkedInPostingIds', 'createdAt', 'updatedAt'
        ])
        && validCanonicalAtsId(request.resource.data.atsJobId)
        && validAtsProvider(request.resource.data.provider)
        && request.resource.data.boardToken is string
        && request.resource.data.jobId is string
        && request.resource.data.canonicalUrl is string
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.linkedInPostingIds is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'atsJobId', 'provider', 'boardToken', 'jobId', 'canonicalUrl',
          'company', 'title', 'linkedInPostingIds', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.atsJobId == resource.data.atsJobId
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.boardToken == resource.data.boardToken
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.canonicalUrl is string
        && request.resource.data.company is string
        && request.resource.data.title is string
        && request.resource.data.linkedInPostingIds is list
        && request.resource.data.linkedInPostingIds.hasAll(resource.data.linkedInPostingIds)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /users/{userId}/submissionAttempts/{attemptId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'attemptId', 'atsJobId', 'linkedInPostingIds', 'status',
          'userConfirmedAt', 'submitClickedAt', 'verification', 'failureCode',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'attemptId', 'atsJobId', 'linkedInPostingIds', 'status',
          'userConfirmedAt', 'submitClickedAt', 'verification', 'failureCode',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.attemptId == attemptId
        && validCanonicalAtsId(request.resource.data.atsJobId)
        && request.resource.data.linkedInPostingIds is list
        && request.resource.data.status == 'pending'
        && validAttemptOutcome(request.resource.data)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'attemptId', 'atsJobId', 'linkedInPostingIds', 'status',
          'userConfirmedAt', 'submitClickedAt', 'verification', 'failureCode',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.attemptId == resource.data.attemptId
        && request.resource.data.atsJobId == resource.data.atsJobId
        && request.resource.data.linkedInPostingIds == resource.data.linkedInPostingIds
        && validUserConfirmationTransition()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && validAttemptTransition()
        && validAttemptOutcome(request.resource.data);
      allow delete: if false;
    }

    match /users/{userId}/applicationMemories/{atsJobDocumentId} {
      allow read: if isOwner(userId);
      // V1 parents remain owner-readable but all V1 client writes are frozen.
      allow create: if isOwner(userId)
        && validV2ApplicationMemory(request.resource.data, atsJobDocumentId);
      allow update: if isOwner(userId)
        && resource.data.schemaVersion == 2
        && validV2ApplicationMemory(request.resource.data, atsJobDocumentId)
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.atsJobId == resource.data.atsJobId
        && request.resource.data.atsJobDocumentId == resource.data.atsJobDocumentId
        && request.resource.data.provider == resource.data.provider
        && request.resource.data.boardToken == resource.data.boardToken
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.canonicalUrl == resource.data.canonicalUrl
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /answers/{fieldKey} {
        allow read: if isOwner(userId) && activeV2Memory(userId, atsJobDocumentId);
        // The V2 parent must already exist; parent and initial answers cannot
        // be created in the same batch under these intermediate rules.
        allow create: if isOwner(userId)
          && activeV2Memory(userId, atsJobDocumentId)
          && validV2AnswerContent(request.resource.data)
          && request.resource.data.fieldKey == fieldKey
          && request.resource.data.revision == 1
          && answerMatchesParent(userId, atsJobDocumentId, request.resource.data);
        allow update: if isOwner(userId)
          && activeV2Memory(userId, atsJobDocumentId)
          && validV2AnswerContent(request.resource.data)
          && request.resource.data.fieldKey == fieldKey
          && answerMatchesParent(userId, atsJobDocumentId, request.resource.data)
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.atsJobId == resource.data.atsJobId
          && request.resource.data.fieldKey == resource.data.fieldKey
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if isOwner(userId) && activeV2Memory(userId, atsJobDocumentId);
      }
    }

    match /users/{userId}/private/{documentId} {
      allow read: if isOwner(userId) && documentId == 'applicantProfile';
      allow create: if isOwner(userId)
        && documentId == 'applicantProfile'
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'city', 'region', 'country',
          'linkedinUrl', 'githubUrl', 'portfolioUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && validOptionalProfileFields(request.resource.data)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && documentId == 'applicantProfile'
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'city', 'region', 'country',
          'linkedinUrl', 'githubUrl', 'portfolioUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && validOptionalProfileFields(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId) && documentId == 'applicantProfile';
    }

    // Explicitly deny access to all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
